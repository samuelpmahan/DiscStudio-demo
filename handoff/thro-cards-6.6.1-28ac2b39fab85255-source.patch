--- baseline-6.6.0/vendor/discstudio/disc/card-fixes.test.mjs	1970-01-01 00:00:00.000000000 +0000
+++ source/vendor/discstudio/disc/card-fixes.test.mjs	2026-10-22 00:22:16.979086800 +0000
